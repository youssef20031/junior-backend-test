# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value below has a safe development default,
# so the API also runs with no .env file at all.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

PORT=3000

# Leave MONGODB_URI unset (or blank) to run against an automatically provisioned
# in-memory MongoDB — zero setup, but data is discarded when the process exits.
# Set it to persist data, e.g. a local server or a MongoDB Atlas cluster:
#   MONGODB_URI=mongodb://127.0.0.1:27017/product-inventory
#   MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/product-inventory
MONGODB_URI=

# REQUIRED when NODE_ENV=production. Outside production a development fallback
# is used and a warning is printed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Access-token lifetime — any value the `ms` library understands (15m, 1h, 7d).
JWT_EXPIRES_IN=1h

# bcrypt cost factor. Higher is slower and safer; 10 is a sane default.
BCRYPT_ROUNDS=10

# Comma-separated list of allowed origins, or * for any.
CORS_ORIGIN=*

# Rate limiting. The auth limiter is deliberately much tighter to blunt
# credential-stuffing attempts. Both are disabled when NODE_ENV=test.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Credentials created by `npm run seed` (and auto-seeded with in-memory Mongo).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=User@123
